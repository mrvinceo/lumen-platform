# Copy to .env and fill in. Never commit .env.

# saas = multi-tenant signup + KMS; selfhost = single deployment, master key from env
LUMEN_MODE=selfhost
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# Password for the docker-compose Postgres container. Choose your own; no default is provided.
POSTGRES_PASSWORD=

# Runtime connection (use the same password as above when running against docker-compose). Tenant queries always run as the `lumen_app` role (RLS enforced).
DATABASE_URL=postgres://lumen:<POSTGRES_PASSWORD>@localhost:5432/lumen
# Optional: a more privileged URL used only for migrations.
DATABASE_ADMIN_URL=

REDIS_URL=redis://localhost:6379

# Encryption of tenant secrets (API keys, OAuth tokens). Generate with: openssl rand -base64 32
# Losing this key makes every stored tenant secret unrecoverable. Back it up.
KEY_PROVIDER=local
MASTER_KEY=
MASTER_KEY_ID=local-v1

# Where uploaded documents are kept: "fs" (local disk; default, good for development and small installs)
# or "s3" (any S3-compatible service: AWS S3, Cloudflare R2, GCS interoperability, SeaweedFS in docker-compose).
STORAGE_DRIVER=fs
# For STORAGE_DRIVER=fs. Leave empty to use .data/uploads in the repository.
STORAGE_DIR=
# Largest single file accepted by the upload API, in MB.
MAX_UPLOAD_MB=50

# S3 settings, used when STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=lumen-uploads
S3_ACCESS_KEY_ID=lumen
S3_SECRET_ACCESS_KEY=lumen-dev-secret

# Port the API listens on (change it if 3000 is already in use on your machine)
PORT=3000

# Browser origin of the console dev server (pnpm dev). Allowed to call the auth endpoints.
CONSOLE_URL=http://localhost:5173

# Optional: session-signing secret (min 32 chars). Derived from MASTER_KEY when left empty.
AUTH_SECRET=
# Set to false to stop new sign-ups once your own account exists.
ALLOW_SIGNUPS=true

# Optional "Sign in with Google / Microsoft" for the console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
