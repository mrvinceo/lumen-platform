# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env.production and fill in.
# NEVER commit deploy/.env.production (it is git-ignored).

# The address Lumen is served at. Its DNS A record must point at this server.
LUMEN_DOMAIN=lumen.ryzomi.com

# Database password: any long random string. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Encrypts the model and vector-store API keys you save in Lumen. Generate with:  openssl rand -base64 32
# KEEP A COPY SOMEWHERE SAFE (e.g. a password manager). Without it, saved keys can't be decrypted,
# even from a backup. Never change it once you've saved keys.
MASTER_KEY=
MASTER_KEY_ID=local-v1
KEY_PROVIDER=local

# Optional: session-signing secret (min 32 chars). Derived from MASTER_KEY when empty.
AUTH_SECRET=

# Leave true until you've created your own account, then set to false and run:
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production up -d api
ALLOW_SIGNUPS=true

LUMEN_MODE=selfhost
LOG_LEVEL=info
MAX_UPLOAD_MB=50
WIDGET_TOKEN_TTL_MIN=120
